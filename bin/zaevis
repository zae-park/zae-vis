#!/usr/bin/env bash
# zaevis — personal work log & knowledge base. This is only a launcher: it finds a Node.js 24+
# (the one bundled in the app, or the system one) and runs server/src/zaevis.ts, which holds the
# actual command on every platform (bin/zaevis.cmd does the same on Windows).
set -euo pipefail

# ── locate the repo / app payload, following the ~/.local/bin symlink ────────
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" == /* ]] || SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

if [[ -x "$ROOT/node/bin/node" ]]; then
  NODE="$ROOT/node/bin/node"                       # inside zaevis.app
else
  NODE="$(command -v node || true)"
  if [[ -z "$NODE" ]]; then
    for c in /opt/homebrew/bin/node /usr/local/bin/node "$HOME/.volta/bin/node" "$HOME/.nvm/versions/node"/*/bin/node; do
      [[ -x "$c" ]] && { NODE="$c"; break; }
    done
  fi
  [[ -n "$NODE" ]] || { echo "✗ Node.js 24 이상이 필요합니다: https://nodejs.org (brew install node@24)" >&2; exit 1; }
  MAJOR="$("$NODE" -p 'process.versions.node.split(".")[0]')"
  [[ "$MAJOR" -ge 24 ]] || { echo "✗ Node.js 24 이상이 필요합니다 (현재 $("$NODE" -v)): brew install node@24" >&2; exit 1; }
fi

exec "$NODE" "$ROOT/server/src/zaevis.ts" "$@"
